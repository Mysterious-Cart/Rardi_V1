@page "/testpage"
@using MudBlazor
@using MudBlazor.Services
@using System.Diagnostics;


<MudText Typo="Typo.h5">Perform test</MudText>
<MudStack>
    <MudContainer Gutters=false>
        <MudTextField @bind-Value="userInput" Label="Tokenizer" Variant="MudBlazor.Variant.Outlined"/>
        <MudStack Row>
            <MudButton OnClick="ProcessInput" @bind-disabled="isProcessing" Variant="MudBlazor.Variant.Filled" Color="Color.Primary">Process</MudButton>
        </MudStack>
        <MudText Typo="Typo.body1">Processed Output: 
            @{
                foreach (string i in processedOutput) { @(i + " "); }
            }
        </MudText>
    </MudContainer>

    <MudContainer Gutters=false>
        <MudStack Row>
            <MudTextField @bind-Value="inputText1" Label="Enter text" Variant="MudBlazor.Variant.Outlined" />
            <MudTextField @bind-Value="inputText2" Label="Enter text" Variant="MudBlazor.Variant.Outlined" />
        </MudStack>
        <MudStack Row>
            <MudButton OnClick="CheckSimilarity" @bind-disabled="isProcessing" Variant="MudBlazor.Variant.Filled" Color="Color.Primary">Process</MudButton>
            <MudText>@similarityScore</MudText>
        </MudStack>

    </MudContainer>

    <MudContainer Gutters=false>
        <MudTextField @bind-Value="Input" Label="Enter text" Variant="MudBlazor.Variant.Outlined"/>
        <MudToolBar style="gap:10px" Gutters=false>
            <MudButton OnClick="FindClosestMatch" @bind-disabled="isProcessing" Variant="MudBlazor.Variant.Filled" Color="Color.Primary">Process</MudButton>
            <MudButton OnClick="@(() => tokenSource.Cancel())" Variant="MudBlazor.Variant.Filled" Color="Color.Primary">Cancel</MudButton>
        </MudToolBar>
        <MudStack style="max-height: 30dvh; overflow-y:scroll;">
            @foreach (var item in ProductMatch)
            {
                <MudText>@(item.Name + ":" +  @item.Score)</MudText>
            }
        </MudStack>
    </MudContainer>

    <MudContainer Gutters=false>
        <MudToolBar style="gap:10px" Gutters=false>
            <MudButton OnClick="@GetInventoryIntegrityReport" @bind-disabled="isProcessing" Variant="MudBlazor.Variant.Filled" Color="Color.Primary">Process</MudButton>
            <MudButton OnClick="@(() => tokenSourceForReport.Cancel())" Variant="MudBlazor.Variant.Filled" Color="Color.Primary">Cancel</MudButton>
        </MudToolBar>
        <MudText>@("Similar: " + result?.Similar + ", Duplicate: "+ result?.Duplicate + ", Fine: "+ result?.Ok + ", Time Taken: " + TimeTaken)</MudText>
        </MudContainer>
    </MudStack>

    @code {
    [Inject]protected InventoryControlService InventoryControlService { get; set; }    
    private string userInput = "";
    private List<string> processedOutput = new List<string>();

    private bool isProcessing = false;
    private async Task ProcessInput()
    {
        CancellationTokenSource cancellationTokenSource = new();
        isProcessing = true;
        if (!string.IsNullOrEmpty(userInput))
        {
            isProcessing = true;
            using var KhmerTokenizerService = new KhmerTokenizer();
            processedOutput = await Task.Run(() => KhmerTokenizerService.Tokenize(userInput, cancellationTokenSource.Token));
            KhmerTokenizerService.Dispose();
            isProcessing = false;
        }
    }

    private string Input = "";
    private CancellationTokenSource tokenSource = new();
    private record ProductScore(Guid Id, double Score, string Name);
    private List<ProductScore> ProductMatch = [];
    private int Top = 50;
    private async Task FindClosestMatch()
    {
        ProductMatch.Clear();
        isProcessing = true;

        var result = await Task.Run(async () => await InventoryControlService.ClosestMatch(Input, token: tokenSource.Token), tokenSource.Token);
        await Task.Run(async () => {
            foreach (var item in result.Take(Top))
            {
                var name = await GetProductName(item.Key);
                ProductMatch.Add(new ProductScore(item.Key, item.Value, name));
            }
        },tokenSource.Token);


        isProcessing = false;
    }

    private async Task<string> GetProductName(Guid id)
    {
        var product = await InventoryControlService.GetProductList();
        return product.Select(i => new{i.Id,i.Name}).First( i => i.Id == id).Name;
    }

    private string inputText1 = "";
    private string inputText2 = "";
    private double similarityScore = 0;
    private async Task CheckSimilarity()
    {
        isProcessing = true;
        using var matcher = new KhmerTokenizer();
        similarityScore = await matcher.CalculateTokenSimilarity(inputText1, inputText2);
        matcher.Dispose();
        isProcessing = false;

    }

    InventoryControlService.InventoryIntegrityReport result = null;
    private CancellationTokenSource tokenSourceForReport = new();
    private double TimeTaken = 0;
    private async Task GetInventoryIntegrityReport(){
        Stopwatch stopwatch = new Stopwatch();
        stopwatch.Start();
        isProcessing = true;
        await Task.Run(async () => { result = await InventoryControlService.GetInventoryIntegrityReport(tokenSourceForReport.Token); });
        isProcessing = false;
        stopwatch.Stop();
        TimeTaken = stopwatch.Elapsed.TotalSeconds;
    }
} 
