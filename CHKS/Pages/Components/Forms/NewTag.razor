@attribute [Authorize]
@using CHKS.Services;
@using CHKS.Extras.Class.DTOs;
@namespace CHKS.Pages.Component.Popup

<MudDialog style="max-height: 400px; width: 30%;">
    <TitleContent>
       @if(Mode==0){
           <MudText Typo="Typo.h5">Create Tag</MudText> 
       }else{    
           <MudText Typo="Typo.h5">Modify Tag</MudText> 
       }
    </TitleContent>
    <DialogContent>

        <MudStack>
            <MudTextField Label="Tag" @bind-Value="Name" />

            <MudTextField Label="Description" @bind-Value="Description" />

            <MudToolBar style="justify-content: flex-end;">
                <MudButton Variant="MudBlazor.Variant.Text" Color="MudBlazor.Color.Success" OnClick="Submit">Submit</MudButton>
                <MudButton Variant="MudBlazor.Variant.Text" Color="MudBlazor.Color.Error" OnClick="Cancel">Cancel</MudButton>
            </MudToolBar>
        </MudStack>

    </DialogContent>

</MudDialog>

@code {
    [Inject]
    private InventoryControlService ProductService { get; set; }
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    
    //New(0), Update(1)
    [Parameter]
    public sbyte Mode { get; set; } = 0;
    [Parameter]
    public TagsDTO Tag { get; set; } = null;

    private async Task Submit() { 
        if(Mode==0){
            await ProductService.CreateTag(new Tag(Guid.NewGuid(), Name, Description));
        }else{
            await ProductService.UpdateTag(new Tag(Guid.NewGuid(), Name, Description));
        }
        MudDialog.Close(DialogResult.Ok(true));
        
    }

    private void Cancel() => MudDialog.Cancel();

    private string Name { get; set; }
    private string Description { get; set; }
    protected override async Task OnParametersSetAsync()
    {
        if(Mode == 1){
            Name = Tag.Name;
            Description = Tag.Description;
        }
    }

}
