@page "/producttag"
@using MudBlazor
@using CHKS.Pages.Component.Popup;
@using CHKS.Extras.Class.DTOs;

<PageTitle>Tag Page</PageTitle>

<MudContainer>
    @if(SelectedTag is not null){
        <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Primary" OnClick="()=>SelectedTag=null">
            Back
        </MudButton>
        <Inventories Tag="@SelectedTag"/>
    }else{

        <MudToolBar Gutters=false style="justify-content: space-between;">
            <MudTextField Placeholder="Type to search" Adornment="MudBlazor.Adornment.End" 
            style="max-width: 35%;"
            T="string" AdornmentIcon="@Icons.Material.Filled.Search"/>
            <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Primary" OnClick="CreateTag">
                New Tag
            </MudButton>
        </MudToolBar>
        <MudStack Wrap=Wrap.Wrap Spacing="3" Justify="Justify.SpaceBetween" style="margin-top: 50px; height: 80dvh; overflow-y: scroll;"
        Row StretchItems="StretchItems.StartAndEnd">

            @if(Tags.Count() == 0){
                <MudText Typo="Typo.h6">No Tags</MudText>
            }else{
                @foreach (var tag in Tags)
                {
                    <MudCard @onclick="@(() => SelectTag(tag))" style="max-width: 48%; height:25dvh; padding:10px; min-width: 48%;">
                        <MudCardHeader>
                            <MudText Typo="Typo.h5">@tag.Name</MudText>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.body1">@tag.Description</MudText>
                        </MudCardContent>
                    </MudCard>

                }
            }


        </MudStack>
    }

</MudContainer>

@code {
    [Inject]
    protected InventoryControlService ProductService { get; set; }
    [Inject]
    protected IDialogService MudDialog { get; set; }
    private IEnumerable<TagsDTO> Tags { get; set; } = [];

    private TagsDTO SelectedTag = null;
    protected override async Task OnInitializedAsync()
    {
        Tags = await ProductService.GetTags();
    }

    private async Task SelectTag(TagsDTO tag){
        MudDialog.ShowMessageBox("Loading..", "Please wait while we load the tag");
        SelectedTag = tag; 
    }

    private async Task CreateTag()
    {
        var result = await MudDialog.ShowAsync<NewTag>("New Tag");
        if (!result.Dismiss(await result.Result))
        {
            Tags = await ProductService.GetTags();
        }
    }
}       
