@using MudBlazor
@inject IDialogService DialogService
@namespace CHKS.Pages.Components

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Validated="OnValidated">
            <MudTextField @bind-Value="Name" Label="First Name" Required="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">Create</MudButton>
        <MudButton OnClick="Cancel" Color="Color.Secondary" Variant="Variant.Text">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject]public EmployeeControl EmployeeControl { get; set; }
    [CascadingParameter] 
    public MudDialogInstance MudDialog { get; set; }
    [Parameter]
    public int GroupId { get; set; }
    private MudForm form;
    private string Name = "";

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            await EmployeeControl.CreateEmployee(Name, GroupId);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void OnValidated()
    {
        // Optional: handle validation events
    }
}