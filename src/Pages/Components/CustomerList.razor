@page "/customer-list"
@attribute [Authorize]
@namespace CHKS.Pages.Component

@using Pages.Component.Popup;
@using Entity;
@using Services;
@using CHKS.Pages;

@implements IAsyncDisposable;

<MudDialog style="height: 80dvh; overflow-y: hidden">
    <DialogContent>
        <TransactionRecords IsDialog=true/> 
    </DialogContent>
</MudDialog>
@code{
    [Inject] protected IDialogService _DialogService { get; set; }
    [Parameter] public string Height {get; set;} = "100%";
    [Parameter] public EventCallback<Entity.Customer> OnRowClick{get; set;}

    private IEnumerable<Entity.Customer> _Customer = [];
    private IEnumerable<Entity.Customer> Display_Customer = [];


    protected async override Task OnInitializedAsync()
    {
        await FetchData_Operation();

    }

    private async Task FetchData_Operation(){
        _Customer = [];
        Display_Customer = [];
        try{
            Task Fetching = FetchCustomerData();

            if(Fetching.Status != TaskStatus.Running){
                await Fetching;
            }
        }catch(Exception exc){

        }
    }

    private async Task FetchCustomerData(){
        

    }

    private string FilterText="";
    private async Task FilterCustomerData(string Filter){
        
    }

    private Entity.Customer SelectedItem;
    private void RowClick(Entity.Customer SelectedCar){
        if(SelectedCar is null){return;}
        OnRowClick.InvokeAsync(SelectedCar);
    }

    private IDialogReference NewCustomerForm;
    private async Task NewCustomer(){
        NewCustomerForm = await _DialogService.ShowAsync<NewCustomer>("New Customer", new MudBlazor.DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
            
        });
    }

    public async ValueTask DisposeAsync()
    {
        _Customer = null;
        Display_Customer = null;
        SelectedItem = null;
        NewCustomerForm?.Close();
        NewCustomerForm = null;
        _DialogService = null;
        GC.SuppressFinalize(this);
        GC.Collect();
    }
}

