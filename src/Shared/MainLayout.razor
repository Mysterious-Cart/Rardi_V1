@inherits LayoutComponentBase
@inject SecurityService SecurityService;

<MudThemeProvider Theme="@KhmerTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudDrawer style="width:200px" Fixed="true" Elevation="1" Variant="@DrawerVariant.Persistent" Open >
        <MudNavMenu style="margin-top: 50px;" >
            <MudNavGroup Expanded title="Cashier" Icon="@Icons.Material.Filled.Sell">
                <MudNavLink Match="NavLinkMatch.All" Href="/" Icon="@Icons.Material.Outlined.MonetizationOn">Register</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Href="/Stock-Notify" Icon="@Icons.Material.Outlined.MonetizationOn">Stock Notify</MudNavLink>
            </MudNavGroup>
            <MudNavGroup Expanded title="Products" Icon="@Icons.Material.Filled.Layers">
                <MudNavLink Match="NavLinkMatch.All" Href="/Inventories" Icon="@Icons.Material.Outlined.Inventory">Inventory</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Href="/packages" Icon="@Icons.Material.Outlined.Archive">Package</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Href="/Orders" Icon="@Icons.Material.Rounded.ReceiptLong">Orders</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Href="/product-analysis" Icon="@Icons.Material.Rounded.Numbers">Product Analysis</MudNavLink>
            </MudNavGroup>
            
            
            <MudNavLink Match="NavLinkMatch.All" Href="/Dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Href="/Histories" Icon="@Icons.Material.Filled.Person">Customer</MudNavLink>
            @if(SecurityService.User.Name == "Admin")
            {
                <MudNavGroup Expanded title="Settings" Icon="@Icons.Material.Filled.Settings">
                    <MudNavLink Match="NavLinkMatch.All" Href="/Settings/Company" Icon="@Icons.Material.Filled.Business">Company</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All" Href="/Settings/Roles" Icon="@Icons.Material.Filled.Person">Users</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All" Href="/Settings/Permissions" Icon="@Icons.Material.Filled.Security">Permissions</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All" Href="/Settings/Backup" Icon="@Icons.Material.Filled.Backup">Backup</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All" Href="/Settings/vehicle" Icon="@Icons.Material.Filled.BusAlert">Vehicle</MudNavLink>

                </MudNavGroup>
            }
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent style="max-height: 100dvh; height:100dvh; overflow:hidden;
        width:auto; position: relative; padding:20px; margin-left: 200px;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    MudTheme KhmerTheme = new MudTheme()
    {
        Typography = new Typography()
        {
            Body1 = new Body1()
            {
                FontFamily = new[] { "Khmer OS Siemreap", "Khmer OS Battambang", "Arial", "sans-serif" },

            },
            Body2 = new Body2()
            {
                FontFamily = new[] { "Khmer OS Siemreap", "Khmer OS Battambang", "Arial", "sans-serif" },

            },
            H5 = new H5()
            {
                FontFamily = new[] { "Khmer OS Siemreap", "Khmer OS Battambang", "Arial", "sans-serif" },

            },
            H6 = new H6()
            {
                FontFamily = new[] { "Khmer OS Siemreap", "Khmer OS Battambang", "Arial", "sans-serif" },

            },
            Caption = new Caption()
            {
                FontFamily = new[] { "Khmer OS Siemreap", "Khmer OS Battambang", "Arial", "sans-serif" },

            },
            Input = new Input
            {
                FontFamily = new[] { "Khmer OS Siemreap", "Khmer OS Battambang", "Arial", "sans-serif" }
            }
        },
    };

}